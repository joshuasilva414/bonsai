{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bonsai",
  // "compatibility_date": "2025-09-02",
  "compatibility_date": "2022-11-07",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "DB",
    "database_id": "3468fbf5-a364-4c44-8a10-d62753440e59",
    "migrations_dir": "drizzle"
  }],
  "main": "src/server.ts",
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "workflows": [
    {
      "name": "create-course-workflow",
      "binding": "CREATE_COURSE_WORKFLOW",
      "class_name": "CreateCourseWorkflow",
    }
  ]
}
